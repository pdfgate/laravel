{
  "name": "pdfgate/laravel",
  "description": "Laravel integration for the PDFGate API: HTML to PDF, PDF forms, e-signature envelopes and signed webhooks.",
  "type": "library",
  "license": "MIT",
  "keywords": [
    "laravel",
    "pdf",
    "pdfgate",
    "html-to-pdf",
    "e-signature",
    "webhooks"
  ],
  "homepage": "https://pdfgate.com",
  "support": {
    "docs": "https://pdfgate.com/documentation",
    "issues": "https://github.com/pdfgate/laravel/issues",
    "source": "https://github.com/pdfgate/laravel"
  },
  "authors": [
    {
      "name": "PDFGate",
      "homepage": "https://pdfgate.com"
    }
  ],
  "require": {
    "php": "^8.2",
    "pdfgate/pdfgate-sdk-php": "^1.3",
    "illuminate/contracts": "^12.0 || ^13.0",
    "illuminate/events": "^12.0 || ^13.0",
    "illuminate/filesystem": "^12.0 || ^13.0",
    "illuminate/http": "^12.0 || ^13.0",
    "illuminate/routing": "^12.0 || ^13.0",
    "illuminate/support": "^12.0 || ^13.0"
  },
  "require-dev": {
    "orchestra/testbench": "^10.0 || ^11.0",
    "phpstan/phpstan": "^2.1",
    "phpunit/phpunit": "^11.0 || ^12.0"
  },
  "autoload": {
    "psr-4": {
      "PdfGate\\Laravel\\": "src/"
    }
  },
  "autoload-dev": {
    "psr-4": {
      "PdfGate\\Laravel\\Tests\\": "tests/"
    }
  },
  "extra": {
    "laravel": {
      "providers": [
        "PdfGate\\Laravel\\PdfGateServiceProvider"
      ],
      "aliases": {
        "PdfGate": "PdfGate\\Laravel\\Facades\\PdfGate"
      }
    }
  },
  "scripts": {
    "test": "phpunit",
    "stan": "phpstan analyse --memory-limit=512M",
    "check": [
      "composer validate --strict",
      "@stan",
      "@test"
    ]
  },
  "config": {
    "sort-packages": true
  },
  "minimum-stability": "stable",
  "prefer-stable": true
}
